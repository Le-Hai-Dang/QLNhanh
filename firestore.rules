rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only staff accounts created by the owner in Firebase Console may use the
    // shared shop data. Add an email here (and deploy the rules) to add staff.
    function staff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email in [
          'admin@lecorner.app'
        ];
    }

    // Entity documents can be edited by staff. Audit collections are
    // append-only and are deliberately excluded from this list.
    match /stores/{storeId}/{collection}/{documentId} {
      allow read: if staff();
      allow create, update: if staff() && collection in [
        'menuItems', 'ingredients', 'recipes', 'sales',
        'purchaseReceipts', 'stockCounts', 'reorderSettings', 'settings'
      ];
      allow delete: if false;
    }
    match /stores/{storeId}/activityEvents/{eventId} {
      allow read, create: if staff();
      allow update, delete: if false;
    }
    match /stores/{storeId}/entityVersions/{versionId} {
      allow read, create: if staff();
      allow update, delete: if false;
    }
    match /stores/{storeId}/stockLedger/{movementId} {
      allow read, create: if staff();
      allow update, delete: if false;
    }
    match /stores/{storeId}/restoreJobs/{jobId} {
      allow read, create, update: if staff();
      allow delete: if false;
    }
  }
}
