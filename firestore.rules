rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }

    // Entity documents can be edited by their owner. Audit collections are
    // append-only and are deliberately excluded from this list.
    match /users/{uid}/{collection}/{documentId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && collection in [
        'menuItems', 'ingredients', 'recipes', 'sales',
        'purchaseReceipts', 'stockCounts', 'reorderSettings', 'settings'
      ];
      allow delete: if false;
    }
    match /users/{uid}/activityEvents/{eventId} {
      allow read, create: if owner(uid);
      allow update, delete: if false;
    }
    match /users/{uid}/entityVersions/{versionId} {
      allow read, create: if owner(uid);
      allow update, delete: if false;
    }
    match /users/{uid}/stockLedger/{movementId} {
      allow read, create: if owner(uid);
      allow update, delete: if false;
    }
    match /users/{uid}/restoreJobs/{jobId} {
      allow read, create: if owner(uid);
      allow update: if owner(uid);
      allow delete: if false;
    }
  }
}
